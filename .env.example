# Neon Postgres. Появляются сами от интеграции Neon в проекте Vercel;
# локально: vercel env pull .env.local
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Подпись cookie сессии. В продакшене обязателен, 32+ символа: openssl rand -base64 32
AUTH_SECRET=

# Загрузка файлов (Vercel Blob). Появляется сама при подключении Blob к проекту.
BLOB_READ_WRITE_TOKEN=
